VERIFY_SECRET=

# Email OTP delivery (without this the code is shown on screen in preview mode)
RESEND_API_KEY=
EMAIL_FROM="31 Capitals <noreply@yourdomain.com>"

# Leads database — Supabase (Project Settings > Database > Connection string).
# Use the TRANSACTION POOLER string on port 6543, not the direct 5432 one:
# serverless hosts open many short-lived connections and exhaust a direct one.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Set to "disable" only for a local Postgres without TLS
DATABASE_SSL=

# Verify the database with:  npm run db:check

# Password for the /admin leads panel. Unset = panel stays closed.
ADMIN_PASSWORD=

# Where verified registrations are sent. Append your KVB IB/tracking code here.
NEXT_PUBLIC_KVB_REGISTER_URL=https://mykvb.com/register?lang=en-US
